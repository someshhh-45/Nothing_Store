# Aiven configuration template — COPY to backend/.env.aiven and keep it private.
# Create these services in your Aiven project; do not commit passwords to Git.
AIVEN_PG_JDBC_URL=jdbc:postgresql://YOUR-AIVEN-PG-HOST:PORT/defaultdb?sslmode=require
AIVEN_PG_USER=avnadmin
AIVEN_PG_PASSWORD=REPLACE_ME
AIVEN_KAFKA_BOOTSTRAP=YOUR-AIVEN-KAFKA-HOST:PORT
# Full JAAS login configuration, all on one line, containing your Aiven Kafka user/password:
AIVEN_KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="REPLACE_ME" password="REPLACE_ME";
AIVEN_OPENSEARCH_URL=https://YOUR-AIVEN-OPENSEARCH-HOST:PORT
AIVEN_OPENSEARCH_USER=avnadmin
AIVEN_OPENSEARCH_PASSWORD=REPLACE_ME
JWT_SECRET=GENERATE_NEW_BASE64_32_BYTE_KEY
JWT_COOKIE_SECURE=false
RABBITMQ_PASSWORD=REPLACE_ME
GRAFANA_ADMIN_PASSWORD=REPLACE_ME
FRONTEND_URL=http://localhost:8000/
SEED_RETAIL_CATALOG=true
APP_HTTP_PORT=8090
APP_METRICS_PORT=8091
FRONTEND_HTTP_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Optional store admin bootstrap (strong secret; never commit real values)
ADMIN_USERNAME=
ADMIN_PASSWORD=
RETAILER_DISCOUNT_PERCENT=10

# Optional pgAdmin web UI for your Aiven Postgres, local-only interface
PGADMIN_EMAIL=admin@example.local
PGADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_SECRET
PGADMIN_PORT=5050

# Optional Stripe-hosted card payment. Use TEST keys first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8000/?checkout=stripe-success
STRIPE_CANCEL_URL=http://localhost:8000/?checkout=stripe-cancel

# Required for new customer signup (OTP sent only through a real SMTP provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Email transport: smtp (default) or gmail-api (Google Cloud OAuth, no SMTP).
# Keep Google OAuth values PRIVATE; the setup script writes them to an ignored .env.
MAIL_PROVIDER=smtp
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
EMAIL_FROM=

# Enable after verifying real SMTP provider credentials and approved sender.
MAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_POLL_MS=5000

MAIL_HEALTH_ENABLED=false
