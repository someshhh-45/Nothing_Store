# Copy to .env (never commit .env). Generate JWT_SECRET using a cryptographically secure Base64 32+ byte key.
LOCAL_DB_PASSWORD=change-me
DATABASE_PASSWORD=change-me
JWT_SECRET=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
RABBITMQ_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
STRIPE_SECRET_KEY=
FRONTEND_URL=http://localhost:8000/

# Optional store admin bootstrap (required to review retailers via the admin UI).
# Use a NEW username; existing customer usernames are never promoted.
ADMIN_USERNAME=
ADMIN_PASSWORD=
RETAILER_DISCOUNT_PERCENT=10

# Optional local-only pgAdmin web UI at http://localhost:5050
PGADMIN_EMAIL=admin@example.local
PGADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_SECRET
PGADMIN_PORT=5050

# Optional Stripe-hosted card payment. Use TEST keys first.
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8000/?checkout=stripe-success
STRIPE_CANCEL_URL=http://localhost:8000/?checkout=stripe-cancel

# Required for NEW customer signup: email OTP is never simulated.
# SMTP or Gmail API OAuth2 can send both signup verification and order receipts.
# Keep credentials only in this private file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Email transport: smtp (default) or gmail-api (Google Cloud OAuth, no SMTP).
# Keep Google OAuth values PRIVATE; the setup script writes them to an ignored .env.
MAIL_PROVIDER=smtp
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
EMAIL_FROM=

# Order confirmations: a real SMTP or Gmail API account is required; not simulation.
# Example for Gmail SMTP testing: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=your verified sender address, SMTP_PASSWORD=your Google app password,
# EMAIL_FROM=the same address. Do not use your regular login password.
# Use your transactional email provider's verified sender settings for production.
# Switch to true only when mail provider access and inbox are verified.
# Emails remain PENDING in PostgreSQL until enabled. Credentials stay in .env only.
MAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_POLL_MS=5000

# Enable SMTP health probe only with working SMTP; signup always validates SMTP separately.
MAIL_HEALTH_ENABLED=false
JWT_COOKIE_SECURE=false
