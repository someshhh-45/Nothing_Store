# Copy to backend/.env.aiven ONLY on a secure machine; never commit actual values.
# The original backend/.env.aiven.example documents the Aiven endpoints.
AIVEN_PG_JDBC_URL=jdbc:postgresql://YOUR-AIVEN-PG-HOST:PORT/defaultdb?sslmode=verify-full&sslrootcert=/etc/ssl/certs/aiven-pg-ca.pem
AIVEN_PG_USER=avnadmin
AIVEN_PG_PASSWORD=REPLACE_ME
AIVEN_PG_CA_PATH=/absolute/path/to/aiven/postgres/ca.pem
AIVEN_KAFKA_BOOTSTRAP=YOUR-AIVEN-KAFKA-HOST:PORT
AIVEN_KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="REPLACE_ME" password="REPLACE_ME";
AIVEN_OPENSEARCH_URL=https://YOUR-AIVEN-OPENSEARCH-HOST:PORT
AIVEN_OPENSEARCH_USER=avnadmin
AIVEN_OPENSEARCH_PASSWORD=REPLACE_ME

JWT_SECRET=REPLACE_WITH_BASE64_32_PLUS_RANDOM_BYTES
RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_16_PLUS_CHARS
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_16_PLUS_CHARS
FRONTEND_URL=https://market.example.com/
TLS_CERT_PATH=/absolute/path/to/your/fullchain.pem
TLS_KEY_PATH=/absolute/path/to/your/privkey.pem
HIBERNATE_DDL_AUTO=validate
SEED_RETAIL_CATALOG=false
DB_POOL_MAX=5
DB_POOL_MIN_IDLE=1
HTTP_MAX_THREADS=80
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443

# Startup owner is provisioned only when this username does not already exist.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# OTP email is mandatory for new customer signup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Email transport: smtp (default) or gmail-api (Google Cloud OAuth, no SMTP).
# Keep Google OAuth values PRIVATE; the setup script writes them to an ignored .env.
MAIL_PROVIDER=smtp
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
EMAIL_FROM=
# Switch on ONLY after real SMTP sender verification.
MAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_POLL_MS=5000
MAIL_HEALTH_ENABLED=false

# Optional Stripe checkout; set all keys and public-domain redirect URLs together.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://market.example.com/?checkout=stripe-success
STRIPE_CANCEL_URL=https://market.example.com/?checkout=stripe-cancel
